# ============================================================================
#  Drum Pattern Generator — deployment env (Coolify / docker-compose)
#  Copy to `.env` and fill in. This service has no database, secrets, or
#  external APIs yet, so there is very little to set.
# ============================================================================

# --- Public URL --------------------------------------------------------------
# Set the domain on the `frontend` service in the Coolify UI (Coolify issues the
# TLS cert and routes it to frontend:80). Nothing to put here.

# --- API base seen by the browser -------------------------------------------
# Keep "/api": nginx proxies /api -> backend on the same origin (no CORS).
# Only change if you host the backend on a separate domain, e.g.
# VITE_API_BASE=https://api.yourdomain.com
VITE_API_BASE=/api

# --- Only for plain `docker compose up` (not needed on Coolify) --------------
# Host port to publish the app on. Uncomment the `ports:` block in
# docker-compose.yml to use it.
APP_PORT=8080

# --- Misc --------------------------------------------------------------------
TZ=UTC

# ============================================================================
#  Backend: auth / accounts (set these on the `backend` service in Coolify)
# ============================================================================

# --- Database ---------------------------------------------------------------
# Prod: the shared Postgres instance, drum-gen's own schema/role. The backend
# must be attached to the `coolify` network to resolve the internal host.
# Local dev uses docker-compose.dev.yml and this default (no need to set):
#   postgresql+asyncpg://drumgen:drumgen@localhost:55432/drumgen
DATABASE_URL=postgresql+asyncpg://drumgen:CHANGE_ME@<internal-db-host>:5432/coach

# --- Sessions / crypto ------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=true          # true in prod (HTTPS); false for local http
# PUBLIC_BASE_URL builds the links inside verification / reset emails.
PUBLIC_BASE_URL=https://drums-gen.duckdns.org

# --- Email (Brevo SMTP) -----------------------------------------------------
# Leave EMAIL_ENABLED=false locally to log emails to the console instead of
# sending. In prod set true and fill the Brevo SMTP credentials.
EMAIL_ENABLED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@rudiment.local
EMAIL_FROM_NAME=Rudiment Engine
